FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY frontend/package.json frontend/
COPY services/auth-service/package.json services/auth-service/
COPY services/planner-service/package.json services/planner-service/
COPY services/progress-service/package.json services/progress-service/
COPY services/ai-service/package.json services/ai-service/
COPY services/gateway-service/package.json services/gateway-service/
COPY services/shared-rest/package.json services/shared-rest/

RUN npm ci --workspace=frontend

COPY . ./

ARG NEXT_PUBLIC_AUTH_API_URL
ARG NEXT_PUBLIC_PROGRESS_API_URL
ARG NEXT_PUBLIC_AI_API_URL
ARG NEXT_PUBLIC_PLANNER_GRAPHQL_URL
ARG NEXT_PUBLIC_WS_URL

ENV NEXT_PUBLIC_AUTH_API_URL=$NEXT_PUBLIC_AUTH_API_URL
ENV NEXT_PUBLIC_PROGRESS_API_URL=$NEXT_PUBLIC_PROGRESS_API_URL
ENV NEXT_PUBLIC_AI_API_URL=$NEXT_PUBLIC_AI_API_URL
ENV NEXT_PUBLIC_PLANNER_GRAPHQL_URL=$NEXT_PUBLIC_PLANNER_GRAPHQL_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3000

RUN npm run build --workspace=frontend

WORKDIR /app/frontend

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-p", "3000", "-H", "0.0.0.0"]